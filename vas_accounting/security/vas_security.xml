<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vas_correspondence_rule_comp_rule" model="ir.rule">
        <field name="name">VAS Correspondence Rule: Multi-Company</field>
        <field name="model_id" ref="model_vas_correspondence_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="vas_account_ledger_comp_rule" model="ir.rule">
        <field name="name">VAS Account Ledger: Multi-Company</field>
        <field name="model_id" ref="model_vas_account_ledger"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
